# Supabase project (publishable key — segura en el browser, vive en bundle JS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Sentry DSN para production (no es secreto, va al frontend)
# Dejalo vacío en dev local; en .env.prod o env vars de Vercel apuntá al DSN real.
SENTRY_DSN=

# Notas:
# - Copiá este archivo a .env (gitignored) y completá con valores reales.
# - El script scripts/generate-env.mjs los lee y genera environment.ts y environment.prod.ts en build.
# - En Vercel: configurar SUPABASE_URL, SUPABASE_ANON_KEY y SENTRY_DSN en Settings → Environment Variables.
# - SENTRY_AUTH_TOKEN sigue siendo Vercel-only (no va acá ni en el repo).
